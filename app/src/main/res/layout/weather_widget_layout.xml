<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Top Section: City and Condition -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="City"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/widget_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Condition"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
            
        <TextView
            android:id="@+id/widget_high_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="H:25° L:18°"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Top Right: Temp and Icon -->
    <LinearLayout
        android:id="@+id/temp_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22°"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:fontFamily="sans-serif-light" />
            
        <TextView
            android:id="@+id/widget_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Middle Row: Weather Details (Filling wasted space) -->
    <LinearLayout
        android:id="@+id/details_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Humidity -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧" android:textSize="10sp" />
            <TextView android:id="@+id/widget_humidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="65%" android:textColor="#B3FFFFFF" android:textSize="10sp" />
        </LinearLayout>

        <!-- Wind -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💨" android:textSize="10sp" />
            <TextView android:id="@+id/widget_wind" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12km/h" android:textColor="#B3FFFFFF" android:textSize="10sp" />
        </LinearLayout>

        <!-- Rain Chance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☔" android:textSize="10sp" />
            <TextView android:id="@+id/widget_rain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10%" android:textColor="#B3FFFFFF" android:textSize="10sp" />
        </LinearLayout>
        
        <!-- Feels Like -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌡️" android:textSize="10sp" />
            <TextView android:id="@+id/widget_feels_like" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21°" android:textColor="#B3FFFFFF" android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom: 8-Hour Forecast Row -->
    <LinearLayout
        android:id="@+id/forecast_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Forecast Item 1 -->
        <LinearLayout
            android:id="@+id/f1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/f1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14:00" android:textColor="#99FFFFFF" android:textSize="9sp" />
            <TextView android:id="@+id/f1_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="14sp" />
            <TextView android:id="@+id/f1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22°" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Forecast Item 2 -->
        <LinearLayout
            android:id="@+id/f2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/f2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15:00" android:textColor="#99FFFFFF" android:textSize="9sp" />
            <TextView android:id="@+id/f2_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="14sp" />
            <TextView android:id="@+id/f2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22°" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Forecast Item 3 -->
        <LinearLayout
            android:id="@+id/f3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/f3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16:00" android:textColor="#99FFFFFF" android:textSize="9sp" />
            <TextView android:id="@+id/f3_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⛅" android:textSize="14sp" />
            <TextView android:id="@+id/f3_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21°" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Forecast Item 4 -->
        <LinearLayout
            android:id="@+id/f4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/f4_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17:00" android:textColor="#99FFFFFF" android:textSize="9sp" />
            <TextView android:id="@+id/f4_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☁️" android:textSize="14sp" />
            <TextView android:id="@+id/f4_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20°" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Forecast Item 5 -->
        <LinearLayout
            android:id="@+id/f5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/f5_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18:00" android:textColor="#99FFFFFF" android:textSize="9sp" />
            <TextView android:id="@+id/f5_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌧️" android:textSize="14sp" />
            <TextView android:id="@+id/f5_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19°" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
