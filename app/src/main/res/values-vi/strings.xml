    <string name="aqi_advice_good">Chất lượng không khí được coi là đạt yêu cầu và ô nhiễm không khí gây ra ít hoặc không có rủi ro.</string>
    <string name="aqi_advice_fair">Chất lượng không khí có thể chấp nhận được; tuy nhiên có thể có mối lo ngại vừa phải đối với những người nhạy cảm.</string>
    <string name="aqi_advice_moderate">Những người thuộc nhóm nhạy cảm có thể gặp các ảnh hưởng về sức khỏe. Công chúng nói chung khó có thể bị ảnh hưởng.</string>
    <string name="aqi_advice_poor">Mọi người có thể bắt đầu gặp các ảnh hưởng sức khỏe; những người nhạy cảm có thể gặp các vấn đề nghiêm trọng hơn.</string>
    <string name="aqi_advice_very_poor">Cảnh báo sức khỏe cho các tình trạng khẩn cấp. Toàn bộ dân số có nhiều khả năng bị ảnh hưởng.</string>
    <string name="aqi_advice_extremely_poor">Chất lượng không khí cực kỳ kém. Hãy ở trong nhà và đóng chặt các cửa sổ.</string>
    <string name="aqi_health_good">Đây là một ngày hoàn hảo cho các hoạt động ngoài trời và tập thể dục. Hãy mở cửa sổ để đón không khí trong lành.</string>
    <string name="aqi_health_fair">Hầu hết mọi người có thể tiếp tục các hoạt động ngoài trời như bình thường. Những người nhạy cảm nên giảm vận động mạnh kéo dài.</string>
    <string name="aqi_health_moderate">Các nhóm nhạy cảm (trẻ em, người già) nên hạn chế thời gian ở ngoài trời.</string>
    <string name="aqi_health_poor">Mọi người nên hạn chế thời gian ở ngoài trời. Đóng cửa sổ và tránh tập thể dục nặng.</string>
    <string name="aqi_health_very_poor">Tránh tất cả các hoạt động thể chất ngoài trời. Hãy ở trong nhà nơi có không khí sạch nếu có thể.</string>
    <string name="aqi_health_extremely_poor">Chất lượng không khí ở mức nguy kịch. Ở trong nhà, sử dụng máy lọc không khí và đóng tất cả các cửa.</string>
